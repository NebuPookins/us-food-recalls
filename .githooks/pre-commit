#!/bin/sh
# Validates the recall data and runs the JS unit tests before every commit.
#
# Wired up by `npm install` (see the "prepare" script), which sets
# core.hooksPath to this directory. Bypass with `git commit --no-verify`;
# CI runs the same checks, so a bypass will still be caught on push.

set -e

# Nothing to check if this commit doesn't touch the data or the schema.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(data/|src/schema\.ts$)'; then
  echo "Validating recall data..."
  npm run --silent validate
fi

# Nothing to test if this commit doesn't touch the client-side filter or its tests.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(static/|test/)'; then
  echo "Running tests..."
  npm run --silent test
fi
